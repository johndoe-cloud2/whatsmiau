# =============================================================================
# Local development – copy to .env when running with "go run" (no Docker).
# For "docker-compose up" the envs are set in docker-compose.yml.
# =============================================================================

# ----- Backend (whatsmiau) - go run main.go ----------------------------------
PORT=8081
DEBUG_MODE=true
DEBUG_WHATSMEOW=false

REDIS_URL=localhost:6379
REDIS_PASSWORD=
REDIS_TLS=false

DIALECT_DB=sqlite3
DB_URL=file:data.db?_foreign_keys=on

# Optional: all events will be sent here (overrides per-instance webhook).
# With "go run": use http://localhost:3456 (or your port).
# With docker-compose: use http://host.docker.internal:3456 so the host receives events (or set in docker-compose).
WEBHOOK_URL=
# Optional: required when behind the router so router can proxy to this process
BACKEND_PUBLIC_URL=http://localhost:8081

API_KEY=

# ----- Router - go run ./cmd/router/ ------------------------------------------
# Router loads .env and uses: REDIS_URL, API_KEY (validates header apikey).
# Run on port 8080 so it doesn't clash with backend: PORT=8080 go run ./cmd/router/

# ----- Optional --------------------------------------------------------------
GCS_ENABLED=false
GCS_BUCKET=whatsmiau
EMITTER_BUFFER_SIZE=2048
HANDLER_SEMAPHORE_SIZE=512
PROXY_ADDRESSES=
PROXY_STRATEGY=RANDOM
PROXY_NO_MEDIA=false
