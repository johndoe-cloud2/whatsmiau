# Infra config for foxy. Copy to aws-infra.foxy.env and fill in.
# Used by: aws-create-stack.sh, aws-update-stack.sh (not push-prod or the app).

# Optional ACM certificate ARN for HTTPS. Leave empty for HTTP-only.
# CERTIFICATE_ARN=arn:aws:acm:us-east-1:ACCOUNT:certificate/ID

# Shared Aurora PostgreSQL Serverless v2 for all backend tasks/instances.
DB_MIN_ACU=0.5
DB_MAX_ACU=4
DB_NAME=whatsmiau
DB_USERNAME=whatsmiau
# REQUIRED: set a strong password (min 8 chars).
DB_PASSWORD=change-me
# Set to true to allow public access (e.g. DBeaver). Less secure.
# DB_PUBLIC_ACCESS=true
