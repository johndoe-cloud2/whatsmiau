# AWS / ECS config for scripts.
# Copy to aws-config.env and set values: cp scripts/aws-config.env.example scripts/aws-config.env
# Scripts load it automatically; or: source scripts/aws-config.env
#
# AWS profile (optional): use a profile from ~/.aws/credentials
# Or pass when running: make infra-create PROFILE=ases  or  make push-prod PROFILE=otro
export AWS_PROFILE="${AWS_PROFILE:-}"

# Stack and region
export STACK_NAME="${STACK_NAME:-whatsmiau}"
export AWS_REGION="${AWS_REGION:-us-east-1}"

# ECR: account ID (optional if you set ECR_REGISTRY directly)
export AWS_ACCOUNT_ID="${AWS_ACCOUNT_ID:-}"
export ECR_REGISTRY="${ECR_REGISTRY:-${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com}"
export ECR_REPO_BACKEND="${ECR_REPO_BACKEND:-whatsmiau}"
export ECR_REPO_ROUTER="${ECR_REPO_ROUTER:-whatsmiau-router}"

# For create-stack (parameters)
export API_SECRET="${API_SECRET:-}"
export WEBHOOK_URL="${WEBHOOK_URL:-https://your-webhook.example.com/events}"
