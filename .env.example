# Copy to .env and adjust. For local Docker: see docker-compose.yml.
# For local "go run": cp env.local.example .env

PORT=8081
DEBUG_MODE=true
DEBUG_WHATSMEOW=false

REDIS_URL=localhost:6379
REDIS_PASSWORD=
REDIS_TLS=false

DIALECT_DB=sqlite3
DB_URL=file:data.db?_foreign_keys=on
# ECS: DB_URL=file:/app/data/data.db?_foreign_keys=on

WEBHOOK_URL=
BACKEND_PUBLIC_URL=http://localhost:8081

API_KEY=

GCS_ENABLED=false
GCS_BUCKET=whatsmiau
EMITTER_BUFFER_SIZE=2048
HANDLER_SEMAPHORE_SIZE=512
PROXY_ADDRESSES=
PROXY_STRATEGY=RANDOM
PROXY_NO_MEDIA=false
