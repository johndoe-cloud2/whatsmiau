API_KEY=https://api.asesadmin.com/api/v2/whatsmiau
WEBHOOK_URL=https://api.asesadmin.com/api/v2/whatsmiau

STACK_NAME=whatsmiau
AWS_REGION=us-east-1
AWS_PROFILE=ases

## All bellow is optional
DIALECT_DB=
DB_URL=

GCS_ENABLED=
GCS_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=

# Enable either GCS or S3, never both. AWS credentials may also come from IAM.
S3_ENABLED=false
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_USE_PATH_STYLE=false
S3_PREFIX=
# Optional public/CDN base URL, including the bucket path when required.
# Leave empty to return signed GET URLs for private objects.
S3_PUBLIC_URL=
S3_PRESIGN_TTL=1h
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

GCL_APP_NAME=
GCL_ENABLED=

API_KEY=

EMITTER_BUFFER_SIZE=
HANDLER_SEMAPHORE_SIZE=

# Emit history sync messages (e.g. recovered undecryptable ones) to the webhook as messages.upsert (deduped via Redis)
HISTORY_SYNC_ENABLED=

PROXY_ADDRESSES=
PROXY_STRATEGY=
PROXY_NO_MEDIA=

CALLS_ENABLED=false
CALL_DEBUG=false
