# Production / deploy. Copy to .env.production and set values.
# Used by: aws-create-stack.sh, aws-update-stack.sh, aws-push-prod.sh, aws-delete-stack.sh

API_KEY=
WEBHOOK_URL=

STACK_NAME=whatsmiau
AWS_REGION=us-east-1
AWS_PROFILE=

AWS_ACCOUNT_ID=
ECR_REGISTRY=
ECR_REPO_BACKEND=whatsmiau
ECR_REPO_ROUTER=whatsmiau-router

# Optional: use existing VPC (avoids creating a new VPC; set all three)
# VPC_ID=vpc-xxxxxxxx
# PUBLIC_SUBNET_IDS=subnet-aaa,subnet-bbb
# PRIVATE_SUBNET_IDS=subnet-ccc,subnet-ddd
